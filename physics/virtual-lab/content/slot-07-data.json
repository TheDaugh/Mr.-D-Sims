  "rules": [
    {
      "id": "ratio-words",
      "text": "Ratio wording on every student screen is 'about double' and 'about half', never 'exactly'. The data carry noise and a tiny drag.",
      "author_set": true,
      "basis": "honest wording for noisy data"
    },
    {
      "id": "markers-apart",
      "text": "Two markers closer than 0.5 s apart give a warning and no reading. Students learn that a short stretch is noisy.",
      "author_set": true,
      "basis": "teaches why a long stretch is better, with no new term"
    }
