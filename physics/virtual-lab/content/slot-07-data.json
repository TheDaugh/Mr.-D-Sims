{
  "slot": 7,
  "lab": "05-fan-cart",
  "room": "physics-lab",
  "course": "Honors Physics",
  "unit": "Forces and Newton's Laws",
  "targets": [
    "F5"
  ],
  "tier": "quantitative: acceleration read from a noisy speed-time line; the model formula is never shown to students (slot 8 owns it)",
  "notes": [
    "Replaces the real second-law lab at slot 7. Mr. D has no fan or cart. Fan cart, not hanging mass: no string, pulley or changing system mass (slots 14 and 19).",
    "The formula the engine uses is a = (F - f) / m. It lives in the engine and in this file's test only. No student screen shows it. Slot 8 turns the two slopes into the law and names the newton.",
    "Every number below is author_set: this is a virtual apparatus, so there is no outside source to cite. Each has a basis."
  ],
  "model": {
    "formula": "a = (F_fan - f_track) / m",
    "studentsNeverSeeFormula": true
  },
  "cart": {
    "mass_kg": {
      "value": 0.5,
      "author_set": true,
      "basis": "round number; a light lab cart"
    },
    "bar_mass_kg": {
      "value": 0.25,
      "author_set": true,
      "basis": "round number; four bars double a 0.50 kg cart twice"
    },
    "bars_on_shelf": {
      "value": 6,
      "author_set": true,
      "basis": "covers the 0 to 4 bars of part 2 and the 3 bars of the test, with spare"
    }
  },
  "track": {
    "length_m": {
      "value": 2,
      "author_set": true,
      "basis": "longest run is a = 0.88 for 2.0 s: 1.76 m"
    },
    "friction_N": {
      "value": 0.01,
      "author_set": true,
      "basis": "tiny drag so the line misses the origin by a hair; a real track is never perfect"
    }
  },
  "fan": {
    "settings": [
      {
        "setting": 1,
        "F_N": 0.15
      },
      {
        "setting": 2,
        "F_N": 0.3
      },
      {
        "setting": 3,
        "F_N": 0.45
      },
      {
        "setting": 4,
        "F_N": 0.6
      }
    ],
    "note": "The force sensor reads the fan force to 0.01 N. Students record it; the fan force does not vary during a run.",
    "author_set": true,
    "basis": "0.15 N per setting, four settings, round numbers"
  },
  "run": {
    "duration_s": {
      "value": 2,
      "author_set": true,
      "basis": "two seconds keeps v under 1.8 m/s and the track under 2 m"
    },
    "sensor_hz": {
      "value": 20,
      "author_set": true,
      "basis": "smooth graph on a Chromebook"
    },
    "noise_sigma_mps": {
      "value": 0.008,
      "author_set": true,
      "basis": "about 2 to 6 percent error on a: students see scatter but the pattern holds"
    },
    "noise_rng": "mulberry32(seed) with Box-Muller; a fresh seed each run",
    "display_decimals": 2
  },
  "markers": {
    "read": "least-squares slope of the speed points between the two markers",
    "minSeparation_s": {
      "value": 0.5,
      "author_set": true,
      "basis": "markers closer than this give a warning, not a number"
    }
  },
